    { "screenshot": "insight-same-key", "full": true },
    { "press": "3" }, { "wait": 250 },
    { "press": "0" }, { "wait": 250 },
    { "press": "4" }, { "wait": 250 },
    { "press": "5" }, { "wait": 1500 },
    { "screenshot": "after-seven", "full": true },
    { "expect": "window.__TEST__.endOffsets().reduce((a,b)=>a+b,0) === 7" },
    { "expect": "(() => { const a = window.__TEST__.partitions().flat().filter(r => r.key === 'alice'); return a.length === 2 && a[0].partition === a[1].partition && a[1].offset > a[0].offset; })()" },
    { "expect": "window.__TEST__.musicStarted() === true" },
    { "wait": 6000 },
    { "screenshot": "shift-complete", "full": true }
